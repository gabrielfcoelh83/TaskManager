node_modules/
.env
npm-debug.log*
.last_good_tag

# Override local do compose de dev (NODE_ENV=test pula a confirmação de
# e-mail). O Compose carrega este arquivo sozinho: versionado, valeria para
# qualquer máquina que rodasse `docker compose up`.
docker-compose.override.yml

# Certificados e chaves privadas nunca são versionados.
# Gerados na VM pelo scripts/bootstrap-cert.sh e pelo certbot.
nginx/certs/
certbot/conf/
certbot/www/
backups/

# bytecode do Python, gerado ao importar o módulo do importador
__pycache__/
*.pyc
