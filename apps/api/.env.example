# Variáveis do compose de DEV (apps/api/docker-compose.yml).
#
# Copie para apps/api/.env (gitignored) e preencha os obrigatórios.
# Produção NÃO lê este arquivo: o .env da VM é regerado a cada deploy pelo
# workflow .github/workflows/api.yml a partir dos secrets/vars do ambiente
# `production` do GitHub.

# ── Obrigatórios (o compose recusa subir sem eles) ─────────────────────────
DB_PASSWORD=troque-esta-senha
# 32+ caracteres. Ex.: openssl rand -hex 32
JWT_SECRET=
# Em dev qualquer valor serve para subir; para o e-mail sair de verdade, use
# uma chave de teste do Resend. Com o override (NODE_ENV=test) a confirmação
# de e-mail é pulada e nenhum e-mail é enviado no cadastro.
RESEND_API_KEY=re_dev_placeholder

# ── URLs (padrões já são de localhost; só mude se usar outras portas) ──────
# Base pública desta API: links de e-mail e o callback do Google.
# A porta 3000 é a rota em HTTP puro do nginx de dev.
APP_BASE_URL=http://localhost:3000
# Onde o front roda (links de reset de senha, volta do Google Agenda).
FRONTEND_BASE_URL=http://localhost:5173
# Remetente de teste do Resend: aceito sem domínio verificado.
EMAIL_FROM=onboarding@resend.dev

# ── Google (opcional em dev) ───────────────────────────────────────────────
# Vazio = login com Google e Google Agenda respondem 503; o resto funciona.
# Para testar de verdade, crie um OAuth client de TESTE no Google Cloud com
# este redirect cadastrado — não reaproveite o de produção.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 64 caracteres hexadecimais. Ex.: openssl rand -hex 32
GOOGLE_TOKEN_ENCRYPTION_KEY=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/google/callback
